# LOG_CHAT: 是否Log 对话记录
LOG_CHAT=True

OPENAI_BASE_URL=https://api.openai.com

# OPENAI_API_KEY：允许输入多个api key 形成轮询池
OPENAI_API_KEY=sk-xxx1 sk-xxx2 sk-xxx3

# FORWARD_KEY: 当前面的OPENAI_API_KEY被设置，就可以设置这里的FORWARD_KEY，客户端调用时可以使用FORWARD_KEY作为api key
FORWARD_KEY=fk-xxx1

# ROUTE_PREFIX: 可指定整个转发服务的根路由前缀
ROUTE_PREFIX=

# 设定时区
TZ=Asia/Shanghai

# IMAGE_GEN_PLATFORM / IMAGE_EDIT_PLATFORM: comma-separated platform list for
# /v1/images/generations and /v1/images/edits.
#
# The FIRST entry is the default. The X-ImageModel request header can select a
# different entry by family ("openai" or "flux"), but only from platforms listed
# here - a client cannot reach a platform this list omits.
#
# Valid for IMAGE_GEN_PLATFORM : openai, dalle3 (alias of openai), flux1_1, flux1_kontext
# Valid for IMAGE_EDIT_PLATFORM: openai, flux1_kontext
#
# Both are parsed at import time: an unknown name stops the service from
# starting. Leave a variable unset (or commented out) to get the OpenAI default.
IMAGE_GEN_PLATFORM=dalle3
IMAGE_EDIT_PLATFORM=openai
